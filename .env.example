# ISTV Reels Tool — environment template.
#
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
#
# Then fill in the two keys below. `.env` is gitignored and never committed.
#
# Who needs this file:
#   • backend/  — yes, it holds the keys for both the Premiere plugin and desktop app
#   • CLI (generate_reels.py) — yes
#   • premiere-plugin/ — NO. Editors never see keys; the panel talks to the backend.

# ── Required ──────────────────────────────────────────────────────────────────

# Rev.ai — speech-to-text with word-level timings and speaker labels.
# Get one at https://www.rev.ai/  (Access Token, under your account settings).
REVAI_API_KEY=

# Anthropic (Claude) — transcript cleanup + reel selection.
# Get one at https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=

# ── Optional: reel selection tuning ───────────────────────────────────────────
# All of these have sensible defaults; set them only to override.

# Profile preset. Default: updated_v2_test2
#REEL_PROFILE=updated_v2_test2

# Reel length bounds in seconds. The v2_test2 profile allows long narrative arcs.
#REEL_MIN_SECONDS=30
#REEL_MAX_SECONDS=90

# Let cut points follow narrative context rather than hard time limits (1/0).
#REEL_CONTEXT_AWARE=1

# Words per on-screen karaoke caption block.
#REEL_CAPTION_CHUNK=4

# Burn in the text hook / speaker lower-third overlays (1/0). Off in v2_test2.
#REEL_TEXT_OVERLAYS=0

# Speaker identity, used to fix STT spellings of the name in captions.
#REEL_SPEAKER_NAME=Caylene Salii
#REEL_SPEAKER_TITLE=Founder
# Comma-separated misspellings the transcript should map back to the real name.
#REEL_NAME_ALIASES=Kaylene,Caylin,Kaylin

# ── Optional: CLI export performance ──────────────────────────────────────────

# Parallel FFmpeg render workers. Defaults to a value derived from your CPU count.
#REEL_MAX_WORKERS=4

# Per-reel export timeout, and a multiplier applied to it for long reels.
#REEL_EXPORT_TIMEOUT_MIN=20
#REEL_EXPORT_TIMEOUT_MULTIPLIER=1.0

# ── Optional: Premiere plugin / desktop app ───────────────────────────────────

# Backend URL used by the desktop app and the Premiere panel. The panel normally
# gets this from premiere-plugin/config.json (baked in at build time); this env var
# overrides it per machine, which is handy while testing.
#ISTV_BACKEND_URL=http://127.0.0.1:8722

# Optional bearer token sent to the backend, if you put one in front of it.
#ISTV_BACKEND_TOKEN=
