# ISTV Reels Tool — environment template.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# Fill in the two keys below. That is all you need. `.env` is gitignored.
#
# Who needs this file:
#   • backend/                 yes — it holds the keys for the Premiere plugin
#   • CLI (generate_reels.py)  yes
#   • premiere-plugin/         no — editors never see keys; the panel calls the backend

# Rev.ai — speech-to-text with word-level timings and speaker labels.
# Get one at https://www.rev.ai/ (Access Token, in your account settings).
REVAI_API_KEY=

# Anthropic (Claude) — transcript cleanup + reel selection.
# Get one at https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=


# ── Optional ──────────────────────────────────────────────────────────────────
# Backend URL for the desktop app and the Premiere panel. The panel normally gets
# this from premiere-plugin/config.json (baked in at build time); this overrides it
# per machine, which is handy while testing against a local backend.
#ISTV_BACKEND_URL=http://127.0.0.1:8722

# Bearer token, if you put auth in front of the backend.
#ISTV_BACKEND_TOKEN=

# The CLI also reads a set of REEL_* tuning variables (reel length, caption chunk
# size, speaker name/aliases, export workers and timeouts). They are profile-driven
# and rarely worth setting by hand — read the defaults at their call sites rather
# than trusting a list here:
#   grep -rn "REEL_" --include=*.py src/ generate_reels.py export_pipeline.py
