<?xml version="1.0" encoding="UTF-8"?>
<!--
  ISTV Reel Tool — Premiere Pro CEP extension manifest.

  CEP (Common Extensibility Platform) panel: an HTML/JS UI (index.html) plus an
  ExtendScript host layer (jsx/host.jsx) that drives Premiere's scripting DOM.
  Node.js is enabled in the panel (see the CEFCommandLine parameters below) so it
  can reuse the repo's proven backend client + bundled FFmpeg for audio export,
  exactly like the old Electron app did — the only difference is that Premiere,
  not FFmpeg, now builds and renders the reels.

  Host range: Premiere Pro 2021 (15.0) and newer. CSXS 9.0 = CEP 11.
-->
<ExtensionManifest Version="8.0" ExtensionBundleId="com.istv.reeltool"
    ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="ISTV Reel Tool"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.istv.reeltool.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- PPRO = Premiere Pro. Wide version range so it loads on 2021+. -->
      <Host Name="PPRO" Version="[15.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.istv.reeltool.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>ISTV Reel Tool</Menu>
          <Geometry>
            <Size>
              <Height>780</Height>
              <Width>440</Width>
            </Size>
            <MinSize>
              <Height>420</Height>
              <Width>360</Width>
            </MinSize>
            <MaxSize>
              <Height>1600</Height>
              <Width>1200</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
